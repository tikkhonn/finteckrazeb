{
  "expo": {
    "name": "ВТБ Go",
    "slug": "vtb-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vtbgo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.vtb.go.hackathon",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна, чтобы сканировать QR магазина и штрихкоды товаров",
        "NSFaceIDUsageDescription": "Подтвердите оплату с помощью Face ID"
      }
    },
    "android": {
      "package": "ru.vtb.go.hackathon",
      "adaptiveIcon": {
        "backgroundColor": "#0033A0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы сканировать QR магазина и штрихкоды товаров",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Подтвердите оплату с помощью Face ID"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0033A0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
